# Only needed if config.yaml `auth: api-key` (e.g. CI). Local runs use logged-in Claude Code.
# Never commit .env. The pipeline never passes this value to the verify agent's prompt or logs.
ANTHROPIC_API_KEY=

# Optional free-cloud model keys (plan-models.md §3). Leave one blank to skip that provider.
# These providers never see prompts/profile.md (profile_allowed_tiers in config.yaml).
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
# Paid APIs (paid-cheap tier, owner opt-in). Same rule: they only get the trimmed profile.
DEEPSEEK_API_KEY=
XAI_API_KEY=
OPENAI_API_KEY=
# Read by docker compose for SearXNG; any random string.
SEARXNG_SECRET=
